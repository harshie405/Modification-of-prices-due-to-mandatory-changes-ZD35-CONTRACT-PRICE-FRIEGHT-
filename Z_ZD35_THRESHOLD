  LOOP AT lt_fname ASSIGNING FIELD-SYMBOL(<lfs_fm1>).
    CALL FUNCTION <lfs_fm1>
      EXPORTING
        i_komk = tkomk
        i_komp = tkomp
        i_vbak = vbak
        c_vbap = vbap
      TABLES
        t_vbap = xvbap
        t_komv = xkomv.
  ENDLOOP.
ENDIF.

