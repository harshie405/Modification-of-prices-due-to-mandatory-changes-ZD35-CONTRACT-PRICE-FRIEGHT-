FUNCTION zcomv_cmr_rej_upd.
*"-----------------------------------------------------------------------*
*"*"Local Interface:                                                     *
*"  IMPORTING                                                            *
*"     REFERENCE(IS_VBAK) TYPE  VBAK                                     *
*"  CHANGING                                                             *
*"     REFERENCE(CS_MSR_SALES_ITEM) TYPE  MSR_S_SALES_ITEM               *
*"     REFERENCE(CV_MSR_RET_REASON) TYPE  MSR_RETURNS_REASON OPTIONAL    *
*"     REFERENCE(CV_MSR_REFUND_CODE) TYPE  MSR_RETURNS_REFUND_CODE       *
*"     REFERENCE(CV_MSR_APPROV_BLOCK) TYPE  MSR_APPROVAL_BLOCK OPTIONAL  *
*"     REFERENCE(CT_NEXT_PLANTS) TYPE  MSR_T_NEXT_PLANTS OPTIONAL        *
*"-----------------------------------------------------------------------*
*& Development ID:  ZDDE-00064252                                        *
*& Development ID:  ZFSE-00064251                                        *
*& BAdI: MSR_SD_SALES                                                    *
*& Implementation class: ZCOMV_CL_THRESHOLD_CALCPRICING                  *
*& Enhancement Implementation: ZCOMV_CHANGE_CMR_REJREASON                *
*& Exit include  zcomv_change_cmr_rejreason                              *
*& Exit Framework : with Include name zcomv_change_cmr_rejreason         *
*& Description: This FM updates Rejection reason Based on  CMR_ABGRU upd *
*&-----------------------------------------------------------------------*                                                                      *
*&-----------------------------------------------------------------------*
*& Change Log:                                                           *
*&                                                                       *
*&  Who           Date            CR             Text                    *
*& AMIREHA1      11-Sep-2024    1100236155     Initial Version           *
*------------------------------------------------------------------------*
  CONSTANTS: lc_repid  TYPE progname VALUE 'ZCOMV_ZD35_THRSHLD',
             lc_const  TYPE zconst   VALUE 'AUGRU',
             lc_const1 TYPE zconst   VALUE 'VBTYP'.

  SELECT const,
         value
    FROM zconstants
    INTO TABLE @DATA(lt_const)
    WHERE repid = @lc_repid
    ORDER BY const, value.
  IF sy-subrc EQ 0.
    IF line_exists( lt_const[ const = lc_const1 value = is_vbak-vbtyp ] ). "check Document type
      IF line_exists( lt_const[ const = lc_const value = is_vbak-augru ] ). "check order reason
        zcomv_cl_threshold_calcpricing=>get_instance( )->set_cmr_rejreason( EXPORTING  is_vbak = is_vbak  CHANGING cs_msr_sales_item = cs_msr_sales_item ).
      ENDIF.
    ENDIF.
  ENDIF.
ENDFUNCTION.
