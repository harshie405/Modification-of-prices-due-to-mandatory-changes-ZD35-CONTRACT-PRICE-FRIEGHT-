    p_val1      = tkomk-vkorg
    p_val2      = tkomk-vtweg
    p_val3      = tkomk-pltyp
  CHANGING
    func_module = lt_fname
  EXCEPTIONS
    not_active  = 1
    OTHERS      = 2.

