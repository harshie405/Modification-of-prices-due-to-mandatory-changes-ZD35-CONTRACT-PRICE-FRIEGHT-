FUNCTION zcomv_threshold_update.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_IDOC_NO) TYPE  EDI_DOCNUM
*"  TABLES
*"      T_VBRP TYPE  STANDARD TABLE
*"      T_VVBRP TYPE  STANDARD TABLE
*"----------------------------------------------------------------------
*& Development ID:  ZDDE-00064252                                        *
*& Development ID:  ZFSE-00064251                                        *
*& Exit:USEREXIT_MOVE_FIELD_TO_VBAP                                      *
*& Enhancement Implementation: ZCOMV_MV45AFZZ_QUANT_UPDATE               *
*& Exit include  ZCOMV_MV45AFZZ_QUANT_UPDATE                             *
*& Description: This FM updates qty based on idoc number                 *
*&-----------------------------------------------------------------------*                                                                      *
*&-----------------------------------------------------------------------*
*& Change Log:                                                           *
*&                                                                       *
*&  Who               Date          Text                                 *
*& AMIREHA1       02-Dec-2024     1100236155  Initial Version            *
*------------------------------------------------------------------------*

  CONSTANTS: lc_e1edp01 TYPE edi_segnam VALUE 'E1EDP01'.

  TYPES:   BEGIN OF ty_cvbrp.
             INCLUDE TYPE vbrpvb.
  TYPES:     pstyn TYPE pstyv,
             rkbel TYPE vbeln_vf,
             rkpos TYPE posnr_vf,
             pctrf TYPE pctrf,
           END OF ty_cvbrp.

  FIELD-SYMBOLS: <lfs_vbrp>  TYPE ty_cvbrp,
                 <lfs_vvbrp> TYPE vbrpvb.

  DATA: ls_e1edp01 TYPE e1edp01.

  SELECT docnum,
         counter,
         segnum,
         segnam,
         psgnum,
         hlevel,
         _dataaging,
         dtint2,
         sdata
    FROM edid4
    INTO TABLE @DATA(lt_edid4)
    WHERE docnum = @i_idoc_no
      AND segnam = @lc_e1edp01
    ORDER BY PRIMARY KEY.
  IF sy-subrc EQ 0.
    LOOP AT lt_edid4 ASSIGNING FIELD-SYMBOL(<ls_edid4>).
      ASSIGN t_vbrp TO <lfs_vbrp>.
      ASSIGN t_vvbrp TO <lfs_vvbrp>.
      IF <lfs_vbrp> IS ASSIGNED AND <lfs_vvbrp> IS ASSIGNED.
        ls_e1edp01 = <ls_edid4>-sdata.
        IF ls_e1edp01-posex = <lfs_vbrp>-posnr.
          IF  <lfs_vbrp> IS NOT INITIAL.
            <lfs_vbrp>-fkimg = ls_e1edp01-menge.
          ENDIF.
          IF <lfs_vvbrp> IS NOT INITIAL.
            <lfs_vvbrp>-fkimg = ls_e1edp01-menge.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFUNCTION.

