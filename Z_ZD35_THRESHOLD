FUNCTION zcomv_thrshld_ret_pol .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_KOMK) TYPE  KOMK
*"     REFERENCE(I_KOMP) TYPE  KOMP
*"     REFERENCE(I_VBAK) TYPE  VBAK
*"     REFERENCE(C_VBAP) TYPE  VBAP
*"  TABLES
*"      T_VBAP STRUCTURE  VBAP
*"      T_KOMV STRUCTURE  KOMV
*"      T_KOMP STRUCTURE  KOMP OPTIONAL
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*& Development ID:  ZDDE-00064252                                      *
*& Functional Spec: ZFSE-00064251                                      *
*&---------------------------------------------------------------------*
*& Title : Apply Returns Based On The Threshold                        *
*& This FM triggers from the include ZCOMV_THRESHOLD_RET_POL via       *
*& USEREXIT_PRICING_PREPARE_TKOMP. This will append ZD35 to the line   *
*& items and adds rejection reason if it is below threshold.           *
*&---------------------------------------------------------------------*
*& Change Log:                                                         *
*&---------------------------------------------------------------------*
*& Init     |  Name     |     Date   |            Text                 *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  06-Sep-2024   CR: 1100236155  Initial version *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITH   02-Dec-2024   CR:1100259353                   *
*&                                     Called FM ZCOMV_ZD35_THRSHLD to *
*&                                     calculate the kwert values from *
*&                                     USEREXIT_PRICING_PREPARE_TKOMP  *
*&RAZAAS6   Asad Raza    19-Jan-2025   CR:1100262522 Changes for Dupli-*
*&                                     cate Pricing issues             *
*&---------------------------------------------------------------------*
  CONSTANTS: lc_repid  TYPE progname VALUE 'ZCOMV_THRSHLD_RET_POL',
             lc_const1 TYPE zconst   VALUE 'VBTYP',
             lc_const  TYPE zconst   VALUE 'AUGRU',
             lc_kschl  TYPE zconst   VALUE 'KSCHL',
             lc_auart  TYPE auart    VALUE 'ZCRA',
             lc_i(1)   TYPE c VALUE 'I',
             lc_eq(2)  TYPE c VALUE 'EQ'.

  DATA: lv_kschl     TYPE kschl,
        lr_augru     TYPE RANGE OF augru,
        lt_komv_temp TYPE TABLE OF komv.

  CLEAR: lv_kschl.

  SELECT const,
         value
    FROM zconstants
   WHERE repid = @lc_repid
   ORDER BY const,value
    INTO TABLE @DATA(lt_const).
  IF sy-subrc EQ 0.
    lr_augru = VALUE #( FOR <fs> IN lt_const
                WHERE ( const = lc_const )
                  LET s = lc_i o = lc_eq
                   IN sign   = s option = o
                    ( low = <fs>-value ) ).
    lv_kschl = VALUE #( lt_const[ const = lc_kschl ]-value OPTIONAL ).

    IF line_exists( lt_const[ const = lc_const1 value = i_komk-vbtyp ] ).
      "if ZD35 is already available then check the threshold and apply rejection reason
      IF line_exists( t_komv[ kschl = lv_kschl kposn = t_vbap-posnr ] ).
        DATA(lv_order_reason) = abap_true.
      ELSE.
        IF i_vbak-auart NE lc_auart.
          IF lv_kschl IS NOT INITIAL AND t_vbap-posnr IS NOT INITIAL AND i_vbak-augru IN lr_augru.
            lt_komv_temp[] = t_komv[].
            DELETE lt_komv_temp WHERE kposn > c_vbap-posnr.
            IF lt_komv_temp IS NOT INITIAL.
              DATA(lv_index) =  lines( lt_komv_temp ).
              lv_index = lv_index + 1.
              DATA(ls_komv) = lt_komv_temp[ 1 ].
              INSERT VALUE #( kschl = lv_kschl kposn = t_vbap-posnr zaehk = ls_komv-zaehk
                             ) INTO t_komv INDEX lv_index.
              lv_order_reason = abap_true.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      IF lv_order_reason = abap_true.
        CALL FUNCTION 'ZCOMV_ZD35_THRSHLD'
          EXPORTING
            i_komk  = i_komk
            is_komp = i_komp
          TABLES
            t_komv  = t_komv.
        zcomv_cl_threshold_calcpricing=>get_instance( )->update_pltyp( EXPORTING i_pltyp = i_komk-pltyp ).
        IF line_exists( lt_const[ const = lc_const value = i_komk-augru ] ).
        ELSE.
          IF i_komk-augru IS NOT INITIAL.
            LOOP AT t_vbap ASSIGNING FIELD-SYMBOL(<lfs_vbap1>).
              IF line_exists( lt_const[ const = lc_const value = i_komk-augru ] ).
                EXIT.
              ELSE.
                DELETE t_komv[] WHERE kschl = lv_kschl AND kposn = <lfs_vbap1>-posnr.
              ENDIF.
            ENDLOOP.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

ENDFUNCTION.

