FUNCTION zcomv_zd35_thrshld .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_KOMK) TYPE  KOMK
*"     REFERENCE(IS_KOMP) TYPE  KOMP OPTIONAL
*"  TABLES
*"      T_KOMV STRUCTURE  KOMV OPTIONAL
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*& Development ID:  ZDDE-00064252                                      *
*& Functional Spec: ZFSE-00064251                                      *
*&---------------------------------------------------------------------*
*& Title : Apply Returns Based On The Threshold                        *
*& This FM triggers from the include ZCOMV_THRESHOLD_RET_POL via       *
*& USEREXIT_PRICING_PREPARE_TKOMP From Function module ZCOMV_THRSHLD_  *
*& RET_POL to calculate the kwert values after appending ZD35          *
*&---------------------------------------------------------------------*
*& Change Log:                                                         *
*&---------------------------------------------------------------------*
*& Init     |  Name     |     Date   |            Text                 *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  06-Sep-2024 CR: 1100236155  Initial version   *
*&---------------------------------------------------------------------*
*& AMIREHA1 A.HARSHITHA  02-Dec-2024 CR: 1100259353                    *
*&                                       Added logic in method         *
*&                                       UPDATE_KOMV to append the     *
*&                                       latest kwert values into      *
*&                                       the table for CMR rejection   *
*&                                       Application                   *
*&RAZAAS6   Asad Raza   19-Jan-2025 CR: 1100262522 Changes for Dupli- *
*&                                       cate Pricing issues           *
*&---------------------------------------------------------------------*
  CONSTANTS: lc_repid   TYPE progname VALUE 'ZCOMV_ZD35_THRSHLD',
             lc_const   TYPE zconst   VALUE 'AUGRU',
             lc_kschl   TYPE zconst   VALUE 'KSCHL',
             lc_percent TYPE char1    VALUE '%',
             lc_pltyp   TYPE zconst   VALUE 'PLTYP_',
             lc_const1  TYPE zconst   VALUE 'VBTYP'.

  DATA: lv_pltyp           TYPE zconst,
        lv_kschl_zd35      TYPE kschl,
        lv_plt             TYPE zconst,
        lv_threshold_kwert TYPE kwert.

  CLEAR:  lv_pltyp, lv_kschl_zd35.

  SELECT const,
         value
    FROM zconstants
    INTO TABLE @DATA(lt_const)
    WHERE repid = @lc_repid
    ORDER BY const, value.
  IF sy-subrc EQ 0.
    lv_kschl_zd35 = VALUE #( lt_const[ const = lc_kschl ]-value OPTIONAL ).
    lv_plt = |{ lc_pltyp }| & |{ i_komk-pltyp }|.
    DATA(lv_threshold_value) = VALUE #( lt_const[ const = lv_plt ]-value OPTIONAL ).
    lv_threshold_kwert = lv_threshold_value.
    DATA(lt_komv) = t_komv[].
    DATA(lt_komv_tmp) = t_komv[].
    DELETE lt_komv_tmp WHERE kposn NE is_komp-kposn.
    IF lt_komv_tmp IS NOT INITIAL.
      DATA(ls_komv) = lt_komv_tmp[ 1 ].
    ENDIF.
    lv_pltyp = |{ lc_pltyp }| & |{ i_komk-pltyp }| & |{ lc_percent }|. "get the pricelist type
    IF line_exists( lt_const[ const = lc_const1 value = i_komk-vbtyp ] ). "check Document type
      IF line_exists( lt_const[ const = lc_const value = i_komk-augru ] ). "check order reason
        LOOP AT lt_komv ASSIGNING FIELD-SYMBOL(<ls_komv>) WHERE kschl EQ lv_kschl_zd35 AND kposn = is_komp-kposn.
          "fetch condition amount from constant table
          IF is_komp-netwr IS NOT INITIAL AND <ls_komv>-kwert IS INITIAL.
            <ls_komv>-knumv = i_komk-knumv.
            <ls_komv>-kappl = i_komk-kappl.
            <ls_komv>-kbetr = VALUE #( lt_const[ const = lv_pltyp ]-value OPTIONAL ) * -1 * 10.
            <ls_komv>-kwert = is_komp-netwr * <ls_komv>-kbetr / 1000. "calulated condition value
            <ls_komv>-kawrt = ls_komv-kawrt.
            <ls_komv>-kmxwr = abap_true.
          ENDIF.
        ENDLOOP.
        IF lt_komv IS NOT INITIAL.
          CLEAR:t_komv[].
          t_komv[] = lt_komv.
        ENDIF.
      ENDIF.
    ENDIF.
    DATA(ls_komv_1) = VALUE #( t_komv[ kschl = lv_kschl_zd35 kposn = is_komp-kposn ] OPTIONAL ).
    IF ls_komv_1-kwert IS NOT INITIAL.
      zcomv_cl_threshold_calcpricing=>get_instance( )->update_komv( EXPORTING  lv_threshold_val = lv_threshold_kwert  is_komv = ls_komv_1 iv_kschl = lv_kschl_zd35 ).
    ENDIF.
    CLEAR lv_kschl_zd35.
  ENDIF.

ENDFUNCTION.

