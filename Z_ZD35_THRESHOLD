           lc_pltyp  TYPE zexitkey  VALUE 'PLTYP',
           lc_prog   TYPE sobj_name VALUE 'ZCOMV_THRESHOLD_RET_POL'.

DATA: lt_fname TYPE fbname.

CLEAR: lt_fname[].

